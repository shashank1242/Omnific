# Copy to .env. docker-compose overrides TEMPORAL_ADDRESS and the S3_* values for in-network use.

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

OPENAI_API_KEY=<your-openai-api-key>
# Pick current model IDs from OpenAI's model list. The critic (MODEL_GENERAL) must differ from the
# Solver-coder's model (MODEL_REASONING).
MODEL_REASONING=gpt-5.5-2026-04-23
MODEL_GENERAL=gpt-5.4-2026-03-05
MODEL_FAST=gpt-5.4-mini-2026-03-17
OPENAI_WEB_SEARCH_TOOL=web_search

# local | s3
# local | s3 (MinIO in compose) | gcs (GKE, via Workload Identity)
ARTIFACT_STORE=local
GCS_BUCKET=
ARTIFACT_DIR=.artifacts
S3_BUCKET=omnific
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# docker | subprocess
SANDBOX_BACKEND=subprocess
SANDBOX_IMAGE=omnific-sandbox-runner
SANDBOX_WORK_DIR=

# Document library (pgvector) and Docker MCP gateway
RAG_DB_PASSWORD=omnific
# compose sets these for containers; for scripts on the host:
RAG_DATABASE_URL=postgresql://omnific:omnific@localhost:5432/omnific_rag
MCP_GATEWAY_URL=http://localhost:8811/mcp
MODEL_EMBEDDING=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536
RAG_MAX_UPLOAD_MB=50
RAG_MAX_FIGURES=40
MCP_SERVERS=duckduckgo,fetch,arxiv-mcp-server,wikipedia-mcp,paper-search
MCP_GATEWAY_AUTH_TOKEN=change-me
# curated research tools (82 are available; fewer = cheaper, sharper tool choice). Sci-Hub/LibGen are always blocked.
MCP_TOOL_ALLOWLIST=search,fetch,search_papers,search_arxiv,read_arxiv_paper,search_semantic,search_crossref,get_crossref_paper_by_doi,search_openalex,search_pubmed,wikipedia_search_wikipedia,wikipedia_get_summary,wikipedia_extract_key_facts
RESEARCH_MAX_STEPS=8
