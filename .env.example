# Copy to .env. docker-compose overrides TEMPORAL_ADDRESS and the S3_* values for in-network use.

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

OPENAI_API_KEY=<your-openai-api-key>
# Pick current model IDs from OpenAI's model list. The critic (MODEL_GENERAL) must differ from the
# Solver-coder's model (MODEL_REASONING).
MODEL_REASONING=gpt-6.2-astra
MODEL_GENERAL=gpt-6.2-sol
MODEL_FAST=gpt-5.4-mini-2026-03-17
# speech-to-text for voice-note attachments (intake agent)
MODEL_TRANSCRIBE=gpt-4o-transcribe
# sketch/photo/voice-note attachments; 25 MB is also OpenAI's transcription limit
INPUT_MAX_UPLOAD_MB=25
# Mesh v2. procedural = MVP shapes; generated = TRELLIS.2 + rig + clips on the mesh-gpu worker
# (docker compose --profile gpu). Per job: POST /jobs {"mesh_backend": ...}
MESH_BACKEND=procedural
# reference images for 3D generation
MODEL_IMAGE=gpt-image-2
# GPU worker backends: trellis2|fake, unirig|none|fake, none|fake (fake = CPU stand-ins for testing the pipeline)
MESH_GEN_BACKEND=trellis2
MESH_RIG_BACKEND=unirig
MESH_ANIM_BACKEND=none
# TRELLIS.2 resolution: 512 (12 GB GPU, the compose default) | 1024 | 1024_cascade (~24 GB) | 1536_cascade
MESH_GEN_PIPELINE=512
# Mesh router: which routes this deployment serves (generated jobs only; procedural is always available).
# GPU: set 1 whenever you run the gpu profile (MESH_GPU_ENABLED=1 docker compose --profile gpu up), else the router
# never picks the generated route. CAD: build123d in the sandbox's CAD runner.
MESH_GPU_ENABLED=0
MESH_CAD_ENABLED=1
# Model libraries for the library route (CC0 / CC-BY only, attribution recorded): objaverse (needs the local index:
# scripts/index_objaverse.py), polypizza (needs POLYPIZZA_API_KEY). Empty = no library route.
# sketchfab (needs SKETCHFAB_API_TOKEN: your personal token from sketchfab.com/settings/password; one token
# for every download, so single-user deployments only), polyhaven (CC0, no key).
MESH_LIBRARY_SOURCES=
POLYPIZZA_API_KEY=
SKETCHFAB_API_TOKEN=
# Ready-made CC0 scenery props for scene dressing: polyhaven (default, no key) or none.
DRESS_PROP_SOURCE=polyhaven
LIBRARY_MAX_MB=50
OPENAI_WEB_SEARCH_TOOL=web_search

# local | s3
# local | s3 (RustFS in compose) | gcs (GKE, via Workload Identity)
ARTIFACT_STORE=local
GCS_BUCKET=
ARTIFACT_DIR=.artifacts
S3_BUCKET=omnific
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# docker | subprocess
SANDBOX_BACKEND=subprocess
SANDBOX_IMAGE=omnific-sandbox-runner
SANDBOX_WORK_DIR=

# Document library (pgvector) and Docker MCP gateway
RAG_DB_PASSWORD=omnific
# compose sets these for containers; for scripts on the host:
RAG_DATABASE_URL=postgresql://omnific:omnific@localhost:5432/omnific_rag
MCP_GATEWAY_URL=http://localhost:8811/mcp
MODEL_EMBEDDING=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536
RAG_MAX_UPLOAD_MB=50
RAG_MAX_FIGURES=40
MCP_SERVERS=duckduckgo,fetch,arxiv-mcp-server,wikipedia-mcp,paper-search
MCP_GATEWAY_AUTH_TOKEN=change-me
# curated research tools (82 are available; fewer = cheaper, sharper tool choice). Sci-Hub/LibGen are always blocked.
MCP_TOOL_ALLOWLIST=search,fetch,search_papers,search_arxiv,read_arxiv_paper,search_semantic,search_crossref,get_crossref_paper_by_doi,search_openalex,search_pubmed,wikipedia_search_wikipedia,wikipedia_get_summary,wikipedia_extract_key_facts
RESEARCH_MAX_STEPS=8

# --- Scene dressing in Blender (docs/architecture.md "Scene dressing") ---
# 1 (default): Blender restyles, decorates and lights each scene and exports a .blend. 0: off (no Blender runner).
DRESS_ENABLED=1
# Local dev (scripts/e2e_local.py, tests): a Python 3.11 with `bpy` installed runs the Blender harness directly,
# e.g. `uv venv .venv-blender --python 3.11` then `uv pip install --python .venv-blender bpy==5.0.1`.
BLENDER_PYTHON=
